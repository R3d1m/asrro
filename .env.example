# ==============================================================================
# ASRRO CUET Web Portal — Environment Variables Configuration
# ==============================================================================

# 1. Neon Serverless Postgres Database (Free Forever: 0.5 GB storage, autoscaling)
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgres://username:password@ep-xxxxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication Secret (JWT session encryption)
# Generate via: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-32-byte-secret-key-here"

# 3. Automated Email via Nodemailer (Gmail / Custom SMTP)
# For Gmail: Use a Google Account App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="contact@asrrocuetbd.org"
SMTP_PASS="your-16-character-gmail-app-password"
SMTP_FROM_NAME="ASRRO CUET Recruitment"
